<mxfile host="drawio"><diagram name="linker_layers" id="linker_layers"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Layer 1 — kernel-common&lt;/b&gt; · linker/kernel/*.ld.in&lt;br&gt;section layout on abstract regions: KERNEL_FLASH · KERNEL_RAM · SHARED_RAM · PERIPH&lt;br&gt;no addresses, no arch instructions, no chip specifics" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#595959;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="500" height="100" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Layer 2 — arch port&lt;/b&gt; · arch/&amp;lt;arch&amp;gt;/linker/*.ld.in&lt;br&gt;uniform across every chip of the arch&lt;br&gt;prologue (OUTPUT_FORMAT, OUTPUT_ARCH, ENTRY) · vectors · TriCore CSA pool, small-data" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#E6E6E6;strokeColor=#595959;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="136" width="500" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Layer 3 — chip input&lt;/b&gt; · board directory (ULMK_CHIP_DIR)&lt;br&gt;memory.ld: MEMORY block, ULMK_MPU_ALIGN, sizes, HAVE_* flags&lt;br&gt;optional bmhd.ld.in · lives with the board, outside the kernel" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#C7C7C7;strokeColor=#595959;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="242" width="500" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Snippets&lt;/b&gt; · linker/snippets/*.ld.in&lt;br&gt;per-app and per-domain sections rendered from CMake declarations" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#595959;fontFamily=Helvetica;fontColor=#1A1A1A;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="348" width="500" height="70" as="geometry"/></mxCell><mxCell id="c6" value="cmake/generate_ld.py&lt;br&gt;runs before link" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#4D4D4D;strokeColor=#333333;fontFamily=Helvetica;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="590" y="170" width="200" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;generated/ulmk.ld&lt;/b&gt;&lt;br&gt;final linker script&lt;br&gt;shipped as linker_&amp;lt;tag&amp;gt;.ld by the SDK" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#595959;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="850" y="170" width="190" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;ld&lt;/b&gt; → ulmk ELF" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#595959;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="850" y="300" width="190" height="56" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;fontColor=#1A1A1A;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="e